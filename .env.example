# Copy to .env.local and fill in. Never commit .env.local.

# Gemini (site assistant chat): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default: gemini-flash-latest)
GEMINI_MODEL=

# Resend (RFI form email): https://resend.com/api-keys
RESEND_API_KEY=
# Inbox that receives RFIs
RFI_TO_EMAIL=
# Sender. Must be on a domain you verified in Resend; until then use
# Portfolio RFI <onboarding@resend.dev> (only delivers to your Resend account email).
RFI_FROM_EMAIL=Portfolio RFI <onboarding@resend.dev>
